DEFAULT_PROVIDER=mock
VLLM_BASE_URL=
OPENROUTER_API_KEY=
LLAMAFILE_BASE_URL=
MAILROOM_BASE_DIR=./data
MAILROOM_API_TOKEN=
MAILROOM_TRACE_MASK=0

# Docker compose (deploy/docker-compose.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Comma-separated host:port list of extra vLLM /metrics endpoints (e.g. Modal); scheme below
VLLM_METRICS_URLS=
VLLM_METRICS_SCHEME=http
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_TP=1
VLLM_DP=1
VLLM_MAX_LEN=32768
MAILROOM_EMBED_WATCHER=1
ML_BUILD_NONE=0

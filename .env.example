DEFAULT_PROVIDER=mock
VLLM_BASE_URL=
OPENROUTER_API_KEY=
LLAMAFILE_BASE_URL=
MAILROOM_BASE_DIR=./data
MAILROOM_API_TOKEN=
MAILROOM_TRACE_MASK=0

# Docker compose (deploy/docker-compose.yml)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# Comma-separated host:port list of extra vLLM /metrics endpoints (e.g. Modal); scheme below
VLLM_METRICS_URLS=
VLLM_METRICS_SCHEME=http
VLLM_MODEL=Qwen/Qwen3-8B-AWQ
VLLM_TP=1
VLLM_DP=1
VLLM_MAX_LEN=32768
MAILROOM_EMBED_WATCHER=1
ML_BUILD_NONE=0

# Jev (TypeSafe System One) decision model — opt-in learned route gate (issue #8).
# provider: off | openrouter | typesafe | local. `off` disables Jev entirely.
# Resolution per field: MAILROOM_JEV_<FIELD> -> JEV_<FIELD> -> taxonomy jev: block.
MAILROOM_JEV_PROVIDER=
MAILROOM_JEV_MODEL=
MAILROOM_JEV_BASE_URL=
MAILROOM_JEV_TEMPERATURE=
MAILROOM_JEV_ACCEPT_THRESHOLD=
MAILROOM_JEV_TIMEOUT_S=
MAILROOM_JEV_MAX_RETRIES=
# API key resolution: MAILROOM_JEV_API_KEY / JEV_API_KEY (explicit override) ->
# provider-preferred hosted key (OPENROUTER_API_KEY for provider=openrouter,
# TYPESAFE_API_KEY for provider=typesafe) -> the other hosted key ->
# settings.openrouter_api_key. The local provider may run without a key (no
# Authorization header is sent).
MAILROOM_JEV_API_KEY=
JEV_API_KEY=
TYPESAFE_API_KEY=

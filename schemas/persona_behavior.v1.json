{"$id":"https://github.com/Exios66/mailroom-sandbox-content/schemas/persona_behavior.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Persona behavior file (personas/behavior/*.yaml), referenced by personas/personas.csv. State machines for the client simulator: patience, escalation, attachment habits, reply templates.","properties":{"attachment_habits":{"properties":{"formats":{"items":{"type":"string"},"type":"array"},"fragmentation":{"description":"e.g. whole, split_across_messages","type":"string"},"naming":{"description":"e.g. generic_filenames, phone_photo_scans, templated_names","type":"string"}},"type":"object"},"escalation":{"properties":{"patience_sim_min":{"minimum":0,"type":"number"},"steps":{"items":{"properties":{"action":{"description":"e.g. polite_followup, angry_escalation, supplies_missing_doc, goes_quiet","type":"string"},"after_sim_min":{"type":"number"}},"required":["after_sim_min","action"],"type":"object"},"type":"array"}},"required":["patience_sim_min","steps"],"type":"object"},"notes":{"type":"string"},"persona_id":{"pattern":"^p_[a-z0-9_]+$","type":"string"},"register":{"type":"string"},"reply_templates":{"items":{"type":"string"},"type":"array"},"tone":{"type":"string"}},"required":["persona_id","escalation","attachment_habits"],"title":"mailroom.persona_behavior/v1","type":"object"}
{
 "$id": "https://github.com/Exios66/mailroom-sandbox-content/schemas/content_files.json",
 "description": "Tabular, one row per entity, bulk-editable -> CSV; nested or behavioral -> YAML; free text -> JSONL or Markdown.",
 "files": {
  "adversary/impostor_personas.csv": {
   "header": [
    "persona_id",
    "impersonates_client_id",
    "claimed_from",
    "scenario_ids",
    "notes"
   ],
   "rules": [
    "sandbox-only; never compiled into the registry"
   ]
  },
  "adversary/lookalike_domains.csv": {
   "header": [
    "domain",
    "impersonates_client_id",
    "technique",
    "scenario_ids"
   ],
   "rules": [
    "sandbox-only; never compiled into the registry"
   ]
  },
  "attachments/manifest.csv": {
   "header": [
    "attachment_id",
    "file",
    "sha256",
    "doc_id",
    "class",
    "stratum",
    "in_taxonomy",
    "source",
    "dataset_revision",
    "dataset_filename",
    "degradation",
    "inert",
    "notes"
   ],
   "rules": [
    "doc_id is first 16 hex of content sha256",
    "inert=true for adversarial files (provably no active content)"
   ]
  },
  "clients/client_contacts.csv": {
   "header": [
    "contact_id",
    "client_id",
    "full_name",
    "role",
    "email",
    "is_registered",
    "usual_channel",
    "notes"
   ],
   "id_pattern": "^[a-z0-9_]+$"
  },
  "clients/client_doc_mix.csv": {
   "header": [
    "client_id",
    "class",
    "stratum",
    "weight",
    "min_per_run",
    "in_taxonomy"
   ],
   "rules": [
    "weights per client sum to 1.0 (class level)",
    "stratum must exist in taxonomy/strata.csv"
   ]
  },
  "clients/client_domains.csv": {
   "header": [
    "domain",
    "client_id",
    "kind"
   ],
   "rules": [
    "registered domains only; lookalikes are NOT here (they live in adversary/)"
   ]
  },
  "clients/clients.csv": {
   "header": [
    "client_id",
    "display_name",
    "kind",
    "relationship",
    "tone",
    "register",
    "verbosity",
    "channels",
    "send_hours",
    "typical_per_day",
    "primary_domain",
    "callback_contact",
    "callback_phone",
    "matter_format",
    "claim_format",
    "status"
   ],
   "id_pattern": "^[a-z0-9_]+$",
   "rules": [
    "primary_domain must end with .sandbox.invalid",
    "callback_phone must match +1-555-01xx",
    "all names/companies fictional"
   ]
  },
  "emails/emails_index.csv": {
   "header": [
    "email_id",
    "spec_id",
    "scenario_id",
    "persona_id",
    "lang",
    "register",
    "words",
    "tier",
    "model_id",
    "prompt_hash",
    "sha256",
    "lint_actions",
    "conformance",
    "template_fallback",
    "frozen_at"
   ],
   "rules": [
    "sha256 is over the canonical frozen JSONL line"
   ]
  },
  "gen/gen_specs_index.csv": {
   "generated": true,
   "header": [
    "spec_id",
    "archetype",
    "persona_id",
    "series",
    "attack_class",
    "pool",
    "constraints_hash",
    "status"
   ]
  },
  "personas/personas.csv": {
   "header": [
    "persona_id",
    "client_id",
    "contact_id",
    "role",
    "behavior_file",
    "language",
    "patience_sim_min",
    "channels"
   ],
   "id_pattern": "^p_[a-z0-9_]+$"
  },
  "relations/dataset_relation_map.csv": {
   "header": [
    "dataset_relation",
    "mailroom_kind",
    "notes"
   ],
   "rules": [
    "maps the dataset's own relationship vocabulary to the eight mailroom kinds"
   ]
  },
  "relations/relations_truth.csv": {
   "header": [
    "relation_id",
    "scenario_id",
    "a_ref",
    "b_ref",
    "kind",
    "source",
    "min_conf",
    "notes"
   ]
  },
  "scenarios/scenarios_index.csv": {
   "generated": true,
   "header": [
    "scenario_id",
    "series",
    "title",
    "gen_mode",
    "min_profile",
    "transports",
    "client_ids",
    "expected_intent",
    "expected_signal",
    "tags",
    "status",
    "owner"
   ],
   "rules": [
    "generated from scenarios/*/*.yaml; do not hand-edit"
   ]
  },
  "taxonomy/coverage.csv": {
   "generated": true,
   "header": [
    "class",
    "stratum",
    "client_ids",
    "scenario_ids",
    "attachment_ids",
    "status"
   ]
  },
  "taxonomy/offtaxonomy.csv": {
   "header": [
    "kind",
    "description",
    "adversarial",
    "expected_handling"
   ],
   "rules": [
    "one row per off-taxonomy document kind (addendum \u00a75); hand-maintained because these are not dataset strata",
    "attachments with class=off_taxonomy use one of these kinds as their stratum",
    "expected_handling is report_never_classify, or quarantine_never_open when adversarial=true"
   ]
  },
  "taxonomy/strata.csv": {
   "generated": true,
   "header": [
    "class",
    "stratum",
    "in_ground_truth",
    "in_live_catalog",
    "rows",
    "status"
   ],
   "rules": [
    "GENERATED by tools/sync_strata.py from mailroom-reloaded scoring/corpus.py; never hand-edit (content-ci diff check)",
    "status: active (rows known) | rows_unverified (in ground truth, rows not yet scanned) | catalog_only (no dataset rows; never drawn)",
    "rows is filled by the dataset scan (tools/build_attachments.py)"
   ]
  }
 },
 "id_conventions": {
  "attachments": "att_<nnnn>, e.g. att_0001",
  "clients": "slug, e.g. tricountytitle",
  "contacts": "<clientprefix>_<name>, e.g. tc_kalvarado",
  "emails": "em_<series>_<nnnn>, e.g. em_E_0042",
  "personas": "p_<client>_<role>, e.g. p_tricounty_real",
  "relations": "rel_<nnnn>, e.g. rel_0001",
  "scenarios": "<Series><n>_<slug>, e.g. E1_lookalike_wire_change",
  "specs": "gen_<archetype>_<nnnn>, e.g. gen_E1_wire_change_0042"
 },
 "title": "Content file formats (addendum v2 \u00a712.4)"
}

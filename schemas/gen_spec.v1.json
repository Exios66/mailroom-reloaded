{"$id":"https://github.com/Exios66/mailroom-sandbox-content/schemas/gen_spec.v1.json","$schema":"https://json-schema.org/draft/2020-12/schema","description":"Generation spec (addendum v2 \u00a76.3). Each email is generated from a spec that states what it must be, so its label is known by construction.","properties":{"archetype":{"description":"Scenario archetype label, e.g. E1. The label, by construction.","type":"string","minLength":1},"attachments":{"items":{"type":"string"},"type":"array"},"attack_class":{"enum":["impersonation","payment_fraud","credential_phish","injection","exfiltration","malicious_attachment","other"]},"constraints":{"properties":{"forbidden":{"description":"Always includes: real_brands, real_urls, working_links, phone_numbers_outside_555_01xx","items":{"type":"string"},"type":"array"},"must_include":{"items":{"type":"string"},"type":"array"}},"type":"object","additionalProperties":false},"context":{"description":"Synthetic values only: matter refs, counterparties, dates. Never real data.","type":"object"},"expect":{"properties":{"attack_class":{"type":"string"},"intent":{"type":"string","enum":["status_request","missing_document_followup","document_submission","correction_or_amendment","duplicate_submission","complaint","urgent_deadline","general_question","unrelated","auto_reply","bounce","spam_or_phishing","possible_prompt_injection","legal_notice","privacy_request","payment_or_identity_change","conflicting_instructions","retraction_or_withdrawal","disclosure_request"]},"quarantine":{"type":"boolean"},"reply_to_sender":{"type":"boolean"},"signal":{"type":"string","enum":["new_info","doc_relation","status_request","missing_doc","correction","complaint","urgent","possible_attack","fyi","legal_notice","privacy_request","payment_change"]}},"required":["intent","signal"],"type":"object","additionalProperties":false},"goal":{"type":"string","minLength":1},"id":{"pattern":"^gen_[a-zA-Z0-9_]+$","type":"string","minLength":1},"persona":{"pattern":"^p_[a-z0-9_]+$","type":"string","minLength":1},"pool":{"description":"Which generation tier this spec targets","enum":["free_pool","paid","scripted"]},"style":{"properties":{"language":{"type":"string"},"length":{"type":"string"},"register":{"type":"string"}},"type":"object","additionalProperties":false},"target_client":{"type":"string","minLength":1}},"required":["id","persona","target_client","archetype","goal","constraints","style","pool","expect"],"title":"mailroom.gen_spec/v1","type":"object","additionalProperties":false}
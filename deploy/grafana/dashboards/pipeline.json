{
  "uid": "mailroom-pipeline",
  "title": "Mailroom Pipeline",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "mailroom"
  ],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(mailroom_documents_total, run_id)",
          "refId": "v"
        },
        "definition": "label_values(mailroom_documents_total, run_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "public_url",
        "label": "public_url",
        "type": "constant",
        "query": "http://localhost:8000",
        "hide": 2,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:8000",
            "value": "http://localhost:8000"
          }
        ],
        "current": {
          "selected": true,
          "text": "http://localhost:8000",
          "value": "http://localhost:8000"
        }
      },
      {
        "name": "phoenix_url",
        "label": "phoenix_url",
        "type": "constant",
        "query": "http://localhost:6006",
        "hide": 2,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:6006",
            "value": "http://localhost:6006"
          }
        ],
        "current": {
          "selected": true,
          "text": "http://localhost:6006",
          "value": "http://localhost:6006"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Documents by status",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(mailroom_documents_total{run_id=~\"$run_id\"}[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Node duration p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(mailroom_node_duration_seconds_bucket{run_id=~\"$run_id\"}[5m])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Gate decisions",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stage, decision) (rate(mailroom_gate_decisions_total{run_id=~\"$run_id\"}[5m]))",
          "legendFormat": "{{stage}} {{decision}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "BERT route mix",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (route) (rate(mailroom_bert_route_total{run_id=~\"$run_id\"}[5m]))",
          "legendFormat": "{{route}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Queue depth",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (bin) (mailroom_queue_depth{run_id=~\"$run_id\"})",
          "legendFormat": "{{bin}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(mailroom_inflight{run_id=~\"$run_id\"})",
          "legendFormat": "inflight"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cost (USD)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(mailroom_cost_usd_total{run_id=~\"$run_id\"})",
          "legendFormat": "total USD"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mailroom_cost_usd_total{run_id=~\"$run_id\"}[5m])) * 3600",
          "legendFormat": "USD per hour"
        }
      ]
    },
    {
      "id": 7,
      "title": "Decisions",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "title": "Retries by kind",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (kind) (increase(mailroom_retries_total{run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 9,
      "title": "Escalations by target",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (to) (increase(mailroom_escalations_total{run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "{{to}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "Review causes",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (cause) (increase(mailroom_review_causes_total{run_id=~\"$run_id\"}[$__rate_interval]))",
          "legendFormat": "{{cause}}"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "replay ↗",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Open this run in the mailroom replay viewer (needs the run_id variable set to one run)",
      "url": "${public_url}/tui#replay=run:${run_id}"
    },
    {
      "title": "phoenix ↗",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Open Phoenix; filter spans on mailroom.run_id = the run_id variable",
      "url": "${phoenix_url}"
    }
  ]
}

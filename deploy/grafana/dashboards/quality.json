{
  "uid": "mailroom-quality",
  "title": "Mailroom Quality",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "tags": [
    "mailroom"
  ],
  "templating": {
    "list": [
      {
        "name": "run_id",
        "label": "run_id",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(mailroom_documents_total, run_id)",
          "refId": "v"
        },
        "definition": "label_values(mailroom_documents_total, run_id)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "doc_type",
        "label": "doc_type",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(mailroom_documents_total{run_id=~\"$run_id\"}, doc_type)",
          "refId": "v"
        },
        "definition": "label_values(mailroom_documents_total{run_id=~\"$run_id\"}, doc_type)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "public_url",
        "label": "public_url",
        "type": "constant",
        "query": "http://localhost:8000",
        "hide": 2,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:8000",
            "value": "http://localhost:8000"
          }
        ],
        "current": {
          "selected": true,
          "text": "http://localhost:8000",
          "value": "http://localhost:8000"
        }
      },
      {
        "name": "phoenix_url",
        "label": "phoenix_url",
        "type": "constant",
        "query": "http://localhost:6006",
        "hide": 2,
        "options": [
          {
            "selected": true,
            "text": "http://localhost:6006",
            "value": "http://localhost:6006"
          }
        ],
        "current": {
          "selected": true,
          "text": "http://localhost:6006",
          "value": "http://localhost:6006"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Documents per run (7d)",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "links": [
            {
              "title": "replay ↗",
              "targetBlank": true,
              "url": "${public_url}/tui#replay=run:${__data.fields.run_id}"
            }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (run_id, status) (increase(mailroom_documents_total{run_id=~\"$run_id\", doc_type=~\"$doc_type\"}[7d]))",
          "legendFormat": "{{run_id}} {{status}}",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 2,
      "title": "Documents by type (rate)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (doc_type) (rate(mailroom_documents_total{run_id=~\"$run_id\", doc_type=~\"$doc_type\"}[15m]))",
          "legendFormat": "{{doc_type}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Schema-valid rate (live)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mailroom_schema_valid_total{run_id=~\"$run_id\"}[15m])) / sum(rate(mailroom_documents_total{run_id=~\"$run_id\"}[15m]))",
          "legendFormat": "schema valid"
        }
      ]
    },
    {
      "id": 4,
      "title": "Length-capped outputs (live)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(mailroom_length_capped_total{run_id=~\"$run_id\"}[15m]))",
          "legendFormat": "length capped"
        }
      ]
    }
  ],
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "replay ↗",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Open this run in the mailroom replay viewer (needs the run_id variable set to one run)",
      "url": "${public_url}/tui#replay=run:${run_id}"
    },
    {
      "title": "phoenix ↗",
      "type": "link",
      "icon": "external link",
      "targetBlank": true,
      "tooltip": "Open Phoenix; filter spans on mailroom.run_id = the run_id variable",
      "url": "${phoenix_url}"
    }
  ]
}

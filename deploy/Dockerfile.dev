# syntax=docker/dockerfile:1
# mailroom-reloaded DEV image: optimized for hot reload with uvicorn --reload.
#
# Design:
#   - python:3.11-slim: minimal base
#   - uv for fast dependency resolution and caching
#   - installs `dev` extra (pytest, ruff, respx) for in-container test runs
#   - expects repository `src/` bind-mounted at /app/src with PYTHONPATH=/app/src
#   - uvicorn --reload watches the mounted source and reloads on file changes
#   - non-root app user for security (configurable UID via APP_UID arg)
#
# Build context: repository root
# Usage:  docker build -f deploy/Dockerfile.dev .

ARG PYTHON_IMAGE=python:3.11-slim-bookworm

FROM ${PYTHON_IMAGE}
COPY --from=ghcr.io/astral-sh/uv:0.8.22 /uv /usr/local/bin/uv
ENV UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_PYTHON_DOWNLOADS=never \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH=/opt/venv/bin:$PATH \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MAILROOM_BASE_DIR=/data \
    HF_HOME=/hf_cache \
    CREWAI_DISABLE_TELEMETRY=true

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first (cache-friendly), then the project itself.
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra dev --no-install-project
COPY src ./src
COPY schemas ./schemas
RUN uv sync --frozen --extra dev

ARG APP_UID=1000
RUN test "$APP_UID" -gt 0 \
    && useradd --create-home --uid "$APP_UID" app \
    && mkdir -p /data /hf_cache \
    && chown -R app:app /data /hf_cache /app
USER app

EXPOSE 8000
CMD ["uvicorn", "mailroom_reloaded.api.app:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/src"]
